# Server-only secrets. Never commit real values.
GROQ_API_KEY=
# KeeperHub ORGANIZATION API key (kh_ prefix). Settings > API Keys > Organisation tab.
# A wfb_ user key will NOT work for direct execution.
KEEPERHUB_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead. Do not set
# both; the publishable key above takes precedence.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# KeeperHub-deployed FinalTabBatchSettlementV2 on Base Sepolia. Public values,
# verified by the retained deployment manifest and Sourcify exact match.
# MCP money tools still fail closed unless the version gate is exactly "2".
NEXT_PUBLIC_SETTLEMENT_CONTRACT=0x7b58791cEBD9A82F8Ee4E4cF87e7AD1B64A3cCDB
FINALTAB_SETTLEMENT_CONTRACT_VERSION=2
# JSON array of scoped API-token records. Store SHA-256 token digests only,
# never plaintext tokens. Example shape:
# [{"name":"mcp-client","subject":"user-or-service-id","tokenSha256":"<64 hex>","scopes":["tabs:read","settlements:prepare","settlements:read"]}]
FINALTAB_API_TOKENS_JSON=
# At least 32 random bytes. Signs expiring, read-only public proof links bound
# to one executionId + V2 contract + settlementId + ledgerHash. It never grants
# prepare or submit access.
FINALTAB_PROOF_SIGNING_SECRET=
# Optional fixed-wallet Base Sepolia demo path. Off by default even when keys
# exist. Enabling value movement also requires a human operator wallet whose
# short-lived EIP-191 approval is checked on every demo broadcast.
FINALTAB_ENABLE_DEMO_MONEY_TOOLS=false
FINALTAB_DEMO_APPROVER_ADDRESS=
# Set to exactly "1" to pin the throwaway demo signers to localStorage so a
# funded testnet address survives a page reload. Off by default: keys are
# regenerated every load and nothing is written to disk. Testnet only — this
# stores disposable private keys in plaintext in the browser.
NEXT_PUBLIC_FINALTAB_PERSIST_DEMO_KEYS=
