# Server-only secrets. Never commit real values.
GROQ_API_KEY=
# Server-only HMAC secret for settlement-agent provenance. Use at least 32
# random bytes. Never expose this value through NEXT_PUBLIC_* or to SQL clients.
FINALTAB_AGENT_ATTESTATION_SECRET=
# Hybrid product voice. These values remain server-only: the browser receives
# only a short-lived AssemblyAI streaming token and proxied ElevenLabs audio.
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional ElevenLabs voice override. Defaults to George when unset.
ELEVENLABS_VOICE_ID=
# Paid provider calls fail closed unless this exact durable budget backend is
# configured, SUPABASE_SECRET_KEY is present, and the committed
# reserve_voice_budget migration is applied. The budget RPC is service-role-only.
# Cap values are fixed in trusted SQL; there are intentionally no browser- or
# environment-controlled overrides that can raise them.
FINALTAB_VOICE_DURABLE_QUOTA=supabase
# KeeperHub ORGANIZATION API key (kh_ prefix). Settings > API Keys > Organisation tab.
# A wfb_ user key will NOT work for direct execution.
KEEPERHUB_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead. Do not set
# both; the publishable key above takes precedence.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Exact canonical browser origin used for callback redirects and same-origin
# mutation checks, e.g. https://finaltab.example. Local HTTP is accepted only
# outside production for localhost/127.0.0.1.
FINALTAB_APP_ORIGIN=
# Server-only release intent for the public GitHub -> Supabase OAuth path.
# Set true only after the GitHub provider, Supabase redirect allow-list, and
# same-device PKCE round trip have been configured and live-probed.
FINALTAB_GITHUB_OAUTH_ENABLED=false
# Optional operator email fallback UI. Keep false when using Supabase default
# mail: default delivery is not public. This flag hides/shows product UI; it is
# not an email-address allowlist or a substitute for provider-side controls.
FINALTAB_TEAM_EMAIL_AUTH_ENABLED=false

# Privy custom-JWT bridge. Supabase Auth remains the canonical account and RLS
# identity; Privy consumes its JWT only to link wallet capability to auth.uid().
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional when the Privy dashboard issues a client ID for this web client.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Optional custom Privy API origin. Leave blank for Privy's hosted default.
NEXT_PUBLIC_PRIVY_API_URL=
# Server-only ES256 public verification key from the matching Privy app.
# Use literal newlines locally or escaped \n characters in a single-line host UI.
PRIVY_VERIFICATION_KEY=
# No PRIVY_APP_SECRET is used or exposed by this integration.
# KeeperHub-deployed FinalTabBatchSettlementV2 on Base Sepolia. Public values,
# verified by the retained deployment manifest and Sourcify exact match.
# MCP money tools still fail closed unless the version gate is exactly "2".
NEXT_PUBLIC_SETTLEMENT_CONTRACT=0x7b58791cEBD9A82F8Ee4E4cF87e7AD1B64A3cCDB
FINALTAB_SETTLEMENT_CONTRACT_VERSION=2
# JSON array of scoped API-token records. Store SHA-256 token digests only,
# never plaintext tokens. Example shape:
# [{"name":"mcp-client","subject":"user-or-service-id","tokenSha256":"<64 hex>","scopes":["tabs:read","settlements:prepare","settlements:read"]}]
FINALTAB_API_TOKENS_JSON=
# Temporary V3 narration operator: store only the lowercase SHA-256 digest of
# its second, dedicated local capability. Never store the raw capability here.
FINALTAB_V3_NARRATION_OPERATOR_TOKEN_SHA256=
# At least 32 random bytes. Signs expiring, read-only public proof links bound
# to one executionId + V2 contract + settlementId + ledgerHash. It never grants
# prepare or submit access.
FINALTAB_PROOF_SIGNING_SECRET=
