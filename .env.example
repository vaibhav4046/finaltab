# Server-only secrets. Never commit real values.
GROQ_API_KEY=
# KeeperHub ORGANIZATION API key (kh_ prefix). Settings > API Keys > Organisation tab.
# A wfb_ user key will NOT work for direct execution.
KEEPERHUB_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Deployed FinalTabBatchSettlement address on Base Sepolia (filled by first-flight)
NEXT_PUBLIC_SETTLEMENT_CONTRACT=
# Set to exactly "1" to pin the throwaway demo signers to localStorage so a
# funded testnet address survives a page reload. Off by default: keys are
# regenerated every load and nothing is written to disk. Testnet only — this
# stores disposable private keys in plaintext in the browser.
NEXT_PUBLIC_FINALTAB_PERSIST_DEMO_KEYS=
