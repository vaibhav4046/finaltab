  "scenes": [
    {
      "scene": 1,
      "start": 0,
      "end": 4,
      "text": "FINALTab. One receipt. One clear settlement."
    },
    {
      "scene": 2,
      "start": 4,
      "end": 12,
      "text": "Turn a shared receipt into an exact split, gather approvals, move test funds once, and leave public proof."
    },
    {
      "scene": 3,
      "start": 12,
      "end": 20,
      "text": "For dinners, trips, team expenses, or agent-led payments, everyone sees each amount, approval, and result."
    },
    {
      "scene": 4,
      "start": 20,
      "end": 30,
      "text": "Vision reads the bill. Math checks every cent. Reviewers check the split and wallet safety. A service runs it. Public test records confirm it."
    },
    {
      "scene": 5,
      "start": 30,
      "end": 50,
      "text": "Watch the product: sign in, create a durable tab, enter the receipt workspace, inspect exact-cent reviews, open the evidence graph, and reach the proof route—one traceable path from input to verification."
    },
    {
      "scene": 6,
      "start": 50,
      "end": 68,
      "text": "Now try a hard request: weighted items, shared service, exclusions, and a payer correction. Typed input stays visible. The model suggests assignments. Math balances every cent. Four reviewers record what passed and why. Memory keeps a compact audit summary."
    },
    {
      "scene": 7,
      "start": 68,
      "end": 85,
      "text": "MCP, the tool connection, signs in, lists nine tools, allocates the receipt, prepares wallet details, and asks for approval. Then it stops: no signing, no sending, and no money moves. A read-only check verifies the earlier authorized settlement."
    },
    {
      "scene": 8,
      "start": 85,
      "end": 90,
      "text": "FINALTab. People approve. The earlier run executed once. Anyone can verify."
    }
  ],
